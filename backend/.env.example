# Hisab Khata Backend Environment Configuration Template
# Copy this file to '.env' and fill in your details.

# Port on which the Express server runs (default: 5050)
PORT=5050

# MongoDB Connection URI (e.g. local mongodb or Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/hisab_khata

# Secret key used for signing JWT Authentication tokens (change this to a secure random string)
JWT_SECRET=your_jwt_secret_token_here_change_me

# Optional: Global Google Sheets Apps Script Web App URL.
# If provided, users can sync their personal budgets here by default.
# Note: Users can still configure their own sheet URLs in settings.
GLOBAL_GOOGLE_SCRIPT_URL=

# Optional: Telegram Bot API Token from @BotFather.
# If left blank, the Telegram Bot logging service is disabled.
TELEGRAM_BOT_TOKEN=
